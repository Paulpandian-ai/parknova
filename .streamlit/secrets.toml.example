# ParkNova secrets template — copy the keys you need into the Streamlit
# Community Cloud dashboard (App → Settings → Secrets) as TOML, with your real
# values. Do NOT commit the real secrets.toml (it is gitignored).
#
# Locally you can either create .streamlit/secrets.toml (gitignored) OR use a
# .env file — the app reads st.secrets first, then falls back to the environment.

# --- Live data (FMP is the primary live source; Finnhub is the quote/history fallback) ---
FMP_API_KEY = "..."
FINNHUB_API_KEY = "..."

# --- Optional: enables the opt-in AI summary / paid filing-analysis fallback ---
ANTHROPIC_API_KEY = "..."

# --- Durable storage (S3) — required on hosted platforms whose disk is ephemeral ---
# When PARKNOVA_S3_BUCKET is set, theses and crest/side indices persist to S3 so
# the local app and the web app share the same durable data.
PARKNOVA_S3_BUCKET = "parknovas3bucket"
# PARKNOVA_S3_PREFIX = "parknova"   # optional; defaults to "parknova"
AWS_ACCESS_KEY_ID = "..."
AWS_SECRET_ACCESS_KEY = "..."
AWS_DEFAULT_REGION = "us-east-1"
