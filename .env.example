FMP_API_KEY=your_key_here

# Near-real-time US quotes + daily-candle history fallback (free tier).
# Sign up at https://finnhub.io -> Dashboard -> free API key.
FINNHUB_API_KEY=your_key_here

# Optional: enables the opt-in "AI Summary" on the News & Filings view.
# Leave unset to use only the deterministic "At a glance" summary.
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: persist computed crest/side indices to S3 instead of local .cache/.
# When unset, indices are stored locally under .cache/store/.
# PARKNOVA_S3_BUCKET=your-bucket-name
# PARKNOVA_S3_PREFIX=parknova

# Optional: PRISM tracing of the Anthropic calls above (data/prism_trace.py).
# No-op when unset. Put real values in .env / Streamlit secrets, never in git.
# PRISMTRACE_API_KEY=pt-sk-...
# PRISMTRACE_PROJECT_ID=your-prism-project-id
# PRISMTRACE_HOST=https://prism-api-prod.up.railway.app
